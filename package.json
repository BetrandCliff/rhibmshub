{
    "name":  "rhibmshub",
    "version":  "0.1.0",
    "private":  true,
    "packageManager":  "npm@12.0.2",
    "dependencies":  {
                         "@vinext/cloudflare":  "latest",
                         "react-server-dom-webpack":  "latest",
                         "vinext":  "latest",
                         "@aws-sdk/client-s3":  "^3.879.0",
                         "@aws-sdk/s3-request-presigner":  "^3.879.0",
                         "@prisma/adapter-neon":  "^6.19.3",
                         "@prisma/client":  "^6.16.2",
                         "bcryptjs":  "^3.0.2",
                         "next":  "^16.3.8",
                         "react":  "^19.2.0",
                         "react-dom":  "^19.2.0",
                         "zod":  "^4.1.5"
                     },
    "devDependencies":  {
                            "@cloudflare/vite-plugin":  "latest",
                            "@vitejs/plugin-react":  "latest",
                            "@vitejs/plugin-rsc":  "latest",
                            "vite":  "latest",
                            "@tailwindcss/postcss":  "^4.3.3",
                            "@types/node":  "^22.0.0",
                            "@types/react":  "^19.0.0",
                            "@types/react-dom":  "^19.0.0",
                            "prisma":  "^6.16.2",
                            "tailwindcss":  "^4.3.3",
                            "tsx":  "^4.19.1",
                            "typescript":  "^5.9.0",
                            "wrangler":  "^4.147.0"
                        },
    "type":  "module",
    "scripts":  {
                    "dev":  "vinext dev",
                    "build":  "vinext build",
                    "start":  "wrangler dev --config dist/server/wrangler.json",
                    "deploy":  "vinext-cloudflare deploy --config dist/server/wrangler.json",
                    "preview":  "npm run build \u0026\u0026 npm run start --",
                    "cf-typegen":  "wrangler types --env-interface CloudflareEnv ./worker-configuration.d.ts",
                    "db:push":  "prisma db push",
                    "db:seed":  "tsx prisma/seed.ts",
                    "prisma:generate":  "prisma generate"
                }
}